# 複製成 .env 後填入你的值(chmod 600 .env)

# Gemini API key(取得: https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# 每頻道新聞抓取上限(頻道定義在 config/channels.json)
NEWS_LIMIT=20

# Gemini 模型(預設 gemini-2.5-flash;有 Pro 存取可改 gemini-2.5-pro)
GEMINI_MODEL=gemini-2.5-flash

# YouTube 上傳隱私(public / unlisted / private;預設 private)
UPLOAD_PRIVACY=private

# 品牌片頭/片尾(自製素材路徑,相對 POC 根目錄)
BRAND_INTRO=output/branding/intro.mp4
BRAND_OUTRO=output/branding/outro.mp4

# 自動刪除已產出影片的 NotebookLM 專案(影片下載成功後 + 每日舊專案掃描;預設 true,設 false 停用)
AUTO_DELETE_NOTEBOOKS=true
